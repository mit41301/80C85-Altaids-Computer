0000                    	CPU 8085U
                        ;########################################################	
                        ;	TITLE "16 bit Subtraction using DSUB instruction"
                        ;########################################################
                        ; 	DSUB Opcode 08H (H)(L)=(H)(L)-(B)(C)

2000                    	ORG	20000O	; Origin of the CODE

2000  06 EC             	MVI	B,60584/400O	; 0ECH load B with Subtrahend MS Byte
2002  0E A8             	MVI	C,60584%256	; 0A8H Load C with Subtrahend LS Byte
2004  2A 2020           	LHLD	Minuend	; load the Minuend
2007  00                	NOP		; Give some rest
2008  08                	DSUB		; DSUB (H)(L)=(H)(L)-(B)(C)
2009  22 2220           	SHLD	Answer	; STORE the result at Answer
200C  C3 0010           	JMP	$-100CH	; Jump to Monitor
200F  76                	HLT		; MOV M,M

2020                    	ORG 20040O	; Database STARTs HERE
2020  DCFE              Minuend	DW 65244	; 0FEDCH <- HEX-DEC->65,244
2022  FFFF              Answer	DW -1		; 1234H <- HEX RESULT(FEDCH-ECA8H)
                        			; 4660D (65,244-60,584)<- DEC RESULT		
                        ;	END

00000 Total Error(s)

ANSWER             00002022    MINUEND            00002020
