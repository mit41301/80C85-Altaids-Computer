                        ; #include <stdio.h>
                        ;
                        ; main()
                        ; {
                        ;     printf("hello, world\n");
                        ; }
                        
   2000                 	ORG	2000H	;load and run from address 2000H
                        
   2000   11 09 20      	LXI 	D, MSG	; load message starting address in DE
   2003   cd 21 10      	CALL    COUT	; send a char pointed out by DE
   2006   cd 00 10      	CALL	MONI    ; return to MONITOR. No RESET required
                        	
   2009   0d 0a 68 65   MSG     DB      0DH,0AH,'hello, world',0DH,0AH,0
   200d   6c 6c 6f 2c   
   2011   20 77 6f 72   
   2015   6c 64 0d 0a   
   2019   00            
   1000                 MONI    EQU	1000H	; monitor start address
   1021                 COUT	EQU	1021H	; monitor routine
   201a                 	END
1021  COUT          1000  MONI          2009  MSG           
