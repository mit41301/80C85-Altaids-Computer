Mandelbrot generator (C) ChatGPT

                        ;#########################################################
                        ; Originally written for Intel 8080 by ChatGPT
   2000                         ORG     2000H
                        
   03fa                 CO      EQU     03FAH
                        ; ============================================================
                        ; Mandelbrot for Intel 8080 / MCS-80 KIT
                        ;
                        ; Display: 79 x 23 characters
                        ;
                        ; Fixed point:
                        ;       128 = 1.0
                        ;
                        ; Program: 1000H onwards
                        ; Stack:   1300H-13FFH -- NEVER TOUCHED BY PROGRAM DATA
                        ; Work:    3000H-33FFH
                        ;
                        ; Exit: RET
                        ; ============================================================
                        
                        ; ------------------------------------------------------------
                        ; Parameter block (this is for easier user access so you can just change those with the ML monitor)
                        ; so the machine doesn't have to render the same image again and again at retrocomputing events
                        ; ------------------------------------------------------------
                        
   3000                 CENTER_X    EQU     3000H
   3002                 CENTER_Y    EQU     3002H
   3004                 STEP_X      EQU     3004H
   3006                 STEP_Y      EQU     3006H
   3008                 ITER_MAX    EQU     3008H
                        
                        ; ------------------------------------------------------------
                        ; Working storage
                        ; ------------------------------------------------------------
                        
   3009                 TOP_Y       EQU     3009H
   300b                 CUR_X       EQU     300BH
   300d                 CUR_Y       EQU     300DH
                        
   300f                 Z_X         EQU     300FH
   3011                 Z_Y         EQU     3011H
                        
   3013                 OLD_X       EQU     3013H
   3015                 OLD_Y       EQU     3015H
                        
   3017                 X2          EQU     3017H
   3019                 Y2          EQU     3019H
                        
   301b                 ITER        EQU     301BH
   301c                 COLS        EQU     301CH
   301d                 ROWS        EQU     301DH
                        
   301e                 SIGN        EQU     301EH
   301f                 MUL_A       EQU     301FH
   3021                 MUL_B       EQU     3021H
                        
                        
                        ; ============================================================
Mandelbrot generator (C) ChatGPT

                        ; PROGRAM
                        ; ============================================================
                        
   2000                 START:
                        
                        ; ------------------------------------------------------------
                        ; Calculate TOP_Y = CENTER_Y - 11 * STEP_Y
                        ; ------------------------------------------------------------
                        
   2000   2a 02 30              LHLD    CENTER_Y
   2003   22 09 30              SHLD    TOP_Y
                        
   2006   06 0b                 MVI     B,11
                        
   2008                 TOP_Y_LOOP:
   2008   2a 09 30              LHLD    TOP_Y
   200b   eb                    XCHG
   200c   2a 06 30              LHLD    STEP_Y
                        
   200f   7b                    MOV     A,E
   2010   95                    SUB     L
   2011   5f                    MOV     E,A
                        
   2012   7a                    MOV     A,D
   2013   9c                    SBB     H
   2014   57                    MOV     D,A
                        
   2015   eb                    XCHG
   2016   22 09 30              SHLD    TOP_Y
                        
   2019   05                    DCR     B
   201a   c2 08 20              JNZ     TOP_Y_LOOP
                        
                        ; ------------------------------------------------------------
                        ; Start at top row
                        ; ------------------------------------------------------------
                        
   201d   2a 09 30              LHLD    TOP_Y
   2020   22 0d 30              SHLD    CUR_Y
                        
   2023   3e 17                 MVI     A,23
   2025   32 1d 30              STA     ROWS
                        
                        ; ============================================================
                        ; ROW LOOP
                        ; ============================================================
                        
   2028                 ROW_LOOP:
                        
                        ; ------------------------------------------------------------
                        ; CUR_X = CENTER_X - 40 * STEP_X
                        ; ------------------------------------------------------------
                        
   2028   2a 00 30              LHLD    CENTER_X
   202b   22 0b 30              SHLD    CUR_X
                        
   202e   06 28                 MVI     B,40
                        
Mandelbrot generator (C) ChatGPT

   2030                 X_START_LOOP:
   2030   2a 0b 30              LHLD    CUR_X
   2033   eb                    XCHG
   2034   2a 04 30              LHLD    STEP_X
                        
   2037   7b                    MOV     A,E
   2038   95                    SUB     L
   2039   5f                    MOV     E,A
                        
   203a   7a                    MOV     A,D
   203b   9c                    SBB     H
   203c   57                    MOV     D,A
                        
   203d   eb                    XCHG
   203e   22 0b 30              SHLD    CUR_X
                        
   2041   05                    DCR     B
   2042   c2 30 20              JNZ     X_START_LOOP
                        
                        ; ------------------------------------------------------------
                        ; 79 columns
                        ; ------------------------------------------------------------
                        
   2045   3e 4f                 MVI     A,79
   2047   32 1c 30              STA     COLS
                        
                        
   204a                 COLUMN_LOOP:
                        
   204a   cd 9b 20              CALL    MANDEL_POINT
                        
                        ; ------------------------------------------------------------
                        ; Map iteration count to density.
                        ;
                        ; 0       -> 0
                        ; 1..2    -> 1
                        ; 3..4    -> 2
                        ; ...
                        ; 13..14  -> 7
                        ; 15+     -> 7
                        ; ------------------------------------------------------------
                        
   204d   fe 0f                 CPI     15
   204f   da 57 20              JC      DENSITY_LOW
                        
   2052   3e 07                 MVI     A,7
   2054   c3 5b 20              JMP     DENSITY_INDEX
                        
   2057                 DENSITY_LOW:
   2057   3c                    INR     A
   2058   0f                    RRC
   2059   e6 07                 ANI     07
                        
   205b                 DENSITY_INDEX:
   205b   5f                    MOV     E,A
   205c   16 00                 MVI     D,0
                        
   205e   21 fd 21              LXI     H,DENSITY
Mandelbrot generator (C) ChatGPT

   2061   19                    DAD     D
                        
   2062   4e                    MOV     C,M
   2063   cd fa 03              CALL    CO
                        
                        ; ------------------------------------------------------------
                        ; CUR_X += STEP_X
                        ; ------------------------------------------------------------
                        
   2066   2a 0b 30              LHLD    CUR_X
   2069   eb                    XCHG
   206a   2a 04 30              LHLD    STEP_X
   206d   19                    DAD     D
   206e   22 0b 30              SHLD    CUR_X
                        
   2071   3a 1c 30              LDA     COLS
   2074   3d                    DCR     A
   2075   32 1c 30              STA     COLS
   2078   c2 4a 20              JNZ     COLUMN_LOOP
                        
                        ; ------------------------------------------------------------
                        ; Newline
                        ; ------------------------------------------------------------
                        
   207b   0e 0d                 MVI     C,0DH
   207d   cd fa 03              CALL    CO
                        
   2080   0e 0a                 MVI     C,0AH
   2082   cd fa 03              CALL    CO
                        
                        ; ------------------------------------------------------------
                        ; CUR_Y += STEP_Y
                        ; ------------------------------------------------------------
                        
   2085   2a 0d 30              LHLD    CUR_Y
   2088   eb                    XCHG
   2089   2a 06 30              LHLD    STEP_Y
   208c   19                    DAD     D
   208d   22 0d 30              SHLD    CUR_Y
                        
   2090   3a 1d 30              LDA     ROWS
   2093   3d                    DCR     A
   2094   32 1d 30              STA     ROWS
   2097   c2 28 20              JNZ     ROW_LOOP
                        
   209a   c9                    RET
                        
                        ; ============================================================
                        ; MANDEL_POINT
                        ;
                        ; Calculate:
                        ;
                        ;       z = z*z + c
                        ;
                        ; starting with z = 0.
                        ;
                        ; Returns A = iteration count.
                        ;
Mandelbrot generator (C) ChatGPT

                        ; A = ITER_MAX means the point survived.
                        ; ============================================================
                        
   209b                 MANDEL_POINT:
                        
   209b   21 00 00              LXI     H,0
   209e   22 0f 30              SHLD    Z_X
   20a1   22 11 30              SHLD    Z_Y
                        
   20a4   af                    XRA     A
   20a5   32 1b 30              STA     ITER
                        
                        
   20a8                 ITERATE:
                        
                        ; ------------------------------------------------------------
                        ; Preserve the old Z values.
                        ; ------------------------------------------------------------
                        
   20a8   2a 0f 30              LHLD    Z_X
   20ab   22 13 30              SHLD    OLD_X
                        
   20ae   2a 11 30              LHLD    Z_Y
   20b1   22 15 30              SHLD    OLD_Y
                        
                        ; ------------------------------------------------------------
                        ; If |X| >= 256, escape.
                        ;
                        ; Allowed values:
                        ;       0000H..00FFH = 0..255
                        ;       FF01H..FFFFH = -255..-1
                        ;
                        ; FF00H is -256 and must escape too.
                        ; ------------------------------------------------------------
                        
   20b4   2a 13 30              LHLD    OLD_X
                        
   20b7   7c                    MOV     A,H
   20b8   fe 00                 CPI     00H
   20ba   ca c7 20              JZ      X_OK
                        
   20bd   fe ff                 CPI     0FFH
   20bf   c2 4e 21              JNZ     ESCAPED
                        
   20c2   7d                    MOV     A,L
   20c3   b7                    ORA     A
   20c4   ca 4e 21              JZ      ESCAPED
                        
   20c7                 X_OK:
                        
                        ; ------------------------------------------------------------
                        ; Same test for Y.
                        ; ------------------------------------------------------------
                        
   20c7   2a 15 30              LHLD    OLD_Y
                        
   20ca   7c                    MOV     A,H
   20cb   fe 00                 CPI     000
Mandelbrot generator (C) ChatGPT

   20cd   ca da 20              JZ      Y_OK
                        
   20d0   fe ff                 CPI     0FFH
   20d2   c2 4e 21              JNZ     ESCAPED
                        
   20d5   7d                    MOV     A,L
   20d6   b7                    ORA     A
   20d7   ca 4e 21              JZ      ESCAPED
                        
   20da                 Y_OK:
                        
                        ; ------------------------------------------------------------
                        ; X2 = OLD_X * OLD_X
                        ; ------------------------------------------------------------
                        
   20da   2a 13 30              LHLD    OLD_X
   20dd   eb                    XCHG
   20de   2a 13 30              LHLD    OLD_X
                        
   20e1   cd 52 21              CALL    SMUL
   20e4   22 17 30              SHLD    X2
                        
                        ; ------------------------------------------------------------
                        ; Y2 = OLD_Y * OLD_Y
                        ; ------------------------------------------------------------
                        
   20e7   2a 15 30              LHLD    OLD_Y
   20ea   eb                    XCHG
   20eb   2a 15 30              LHLD    OLD_Y
                        
   20ee   cd 52 21              CALL    SMUL
   20f1   22 19 30              SHLD    Y2
                        
                        ; ------------------------------------------------------------
                        ; Escape if X2 + Y2 >= 4.
                        ;
                        ; With 128 = 1.0:
                        ;
                        ;       4 * 128 * 128 = 65536
                        ;
                        ; Carry from the 16-bit addition means >= 4.
                        ; ------------------------------------------------------------
                        
   20f4   2a 17 30              LHLD    X2
   20f7   eb                    XCHG
                        
   20f8   2a 19 30              LHLD    Y2
   20fb   19                    DAD     D
                        
   20fc   da 4e 21              JC      ESCAPED
                        
                        ; ------------------------------------------------------------
                        ; Convert squares to fixed-point:
                        ;
                        ;       raw square / 128
                        ; ------------------------------------------------------------
                        
   20ff   2a 17 30              LHLD    X2
Mandelbrot generator (C) ChatGPT

   2102   cd ca 21              CALL    SHR7
   2105   22 17 30              SHLD    X2
                        
   2108   2a 19 30              LHLD    Y2
   210b   cd ca 21              CALL    SHR7
   210e   22 19 30              SHLD    Y2
                        
                        ; ============================================================
                        ; New X:
                        ;
                        ;       X = X2 - Y2 + CUR_X
                        ; ============================================================
                        
   2111   2a 19 30              LHLD    Y2
   2114   eb                    XCHG
                        
   2115   2a 17 30              LHLD    X2
                        
   2118   7d                    MOV     A,L
   2119   93                    SUB     E
   211a   6f                    MOV     L,A
                        
   211b   7c                    MOV     A,H
   211c   9a                    SBB     D
   211d   67                    MOV     H,A
                        
                        ; HL = X2 - Y2
                        
   211e   eb                    XCHG
                        
   211f   2a 0b 30              LHLD    CUR_X
   2122   19                    DAD     D
                        
   2123   22 0f 30              SHLD    Z_X
                        
                        ; ============================================================
                        ; New Y:
                        ;
                        ;       Y = 2 * OLD_X * OLD_Y + CUR_Y
                        ;
                        ; Raw product is shifted right 6:
                        ;
                        ;       (X * Y * 128 * 128) / 64
                        ;       = X * Y * 256
                        ;
                        ; which represents 2*X*Y at scale 128.
                        ; ============================================================
                        
   2126   2a 13 30              LHLD    OLD_X
   2129   eb                    XCHG
                        
   212a   2a 15 30              LHLD    OLD_Y
                        
   212d   cd 52 21              CALL    SMUL
                        
   2130   cd d8 21              CALL    ASR6
                        
   2133   eb                    XCHG
Mandelbrot generator (C) ChatGPT

                        
   2134   2a 0d 30              LHLD    CUR_Y
   2137   19                    DAD     D
                        
   2138   22 11 30              SHLD    Z_Y
                        
                        
                        ; ------------------------------------------------------------
                        ; ITER++
                        ; ------------------------------------------------------------
                        
   213b   3a 1b 30              LDA     ITER
   213e   3c                    INR     A
   213f   32 1b 30              STA     ITER
                        
   2142   47                    MOV     B,A
                        
   2143   3a 08 30              LDA     ITER_MAX
   2146   b8                    CMP     B
   2147   c2 a8 20              JNZ     ITERATE
                        
                        ; Survived all iterations.
                        
   214a   3a 1b 30              LDA     ITER
   214d   c9                    RET
                        
                        
   214e                 ESCAPED:
                        
   214e   3a 1b 30              LDA     ITER
   2151   c9                    RET
                        
                        ; ============================================================
                        ; SMUL
                        ;
                        ; Signed 16-bit multiply.
                        ;
                        ; Input:
                        ;       HL = signed value
                        ;       DE = signed value
                        ;
                        ; The caller must ensure:
                        ;       - Both operands are in -255..+255.
                        ;       - The signed product fits in 16 bits.
                        ;
                        ; Output:
                        ;       HL = signed product
                        ; ============================================================
                        
   2152                 SMUL:
                        
   2152   22 1f 30              SHLD    MUL_A
   2155   eb                    XCHG
   2156   22 21 30              SHLD    MUL_B
                        
                        ; ------------------------------------------------------------
                        ; Determine sign of result.
                        ; ------------------------------------------------------------
Mandelbrot generator (C) ChatGPT

                        
   2159   af                    XRA     A
   215a   32 1e 30              STA     SIGN
                        
   215d   2a 1f 30              LHLD    MUL_A
                        
   2160   7c                    MOV     A,H
   2161   e6 80                 ANI     080H
   2163   ca 71 21              JZ      A_POSITIVE
                        
   2166   3e 01                 MVI     A,1
   2168   32 1e 30              STA     SIGN
                        
   216b   cd a0 21              CALL    ABS_HL
   216e   22 1f 30              SHLD    MUL_A
                        
                        
   2171                 A_POSITIVE:
                        
   2171   2a 21 30              LHLD    MUL_B
                        
   2174   7c                    MOV     A,H
   2175   e6 80                 ANI     080H
   2177   ca 88 21              JZ      B_POSITIVE
                        
   217a   3a 1e 30              LDA     SIGN
   217d   ee 01                 XRI     1
   217f   32 1e 30              STA     SIGN
                        
   2182   cd a0 21              CALL    ABS_HL
   2185   22 21 30              SHLD    MUL_B
                        
                        
   2188                 B_POSITIVE:
                        
                        ; ------------------------------------------------------------
                        ; Low bytes are now the unsigned operands.
                        ; ------------------------------------------------------------
                        
   2188   2a 1f 30              LHLD    MUL_A
   218b   45                    MOV     B,L
                        
   218c   2a 21 30              LHLD    MUL_B
   218f   4d                    MOV     C,L
                        
   2190   cd ac 21              CALL    MUL8
                        
                        ; ------------------------------------------------------------
                        ; Apply sign.
                        ; ------------------------------------------------------------
                        
   2193   3a 1e 30              LDA     SIGN
   2196   b7                    ORA     A
   2197   c8                    RZ
                        
   2198   7d                    MOV     A,L
   2199   2f                    CMA
   219a   6f                    MOV     L,A
Mandelbrot generator (C) ChatGPT

                        
   219b   7c                    MOV     A,H
   219c   2f                    CMA
   219d   67                    MOV     H,A
                        
   219e   23                    INX     H
                        
   219f   c9                    RET
                        
                        ; ============================================================
                        ; ABS_HL
                        ;
                        ; Absolute value of signed 16-bit HL.
                        ; ============================================================
                        
   21a0                 ABS_HL:
                        
   21a0   7c                    MOV     A,H
   21a1   e6 80                 ANI     080H
   21a3   c8                    RZ
                        
   21a4   7d                    MOV     A,L
   21a5   2f                    CMA
   21a6   6f                    MOV     L,A
                        
   21a7   7c                    MOV     A,H
   21a8   2f                    CMA
   21a9   67                    MOV     H,A
                        
   21aa   23                    INX     H
                        
   21ab   c9                    RET
                        
                        
                        ; ============================================================
                        ; MUL8
                        ;
                        ; Unsigned 8 x 8 -> 16 bit.
                        ;
                        ; Input:
                        ;       B = multiplicand
                        ;       C = multiplier
                        ;
                        ; Output:
                        ;       HL = product
                        ; ============================================================
                        
   21ac                 MUL8:
                        
   21ac   21 00 00              LXI     H,0
                        
   21af   58                    MOV     E,B
   21b0   16 00                 MVI     D,0
                        
   21b2   06 08                 MVI     B,8
                        
   21b4                 MUL_LOOP:
                        
Mandelbrot generator (C) ChatGPT

   21b4   79                    MOV     A,C
   21b5   e6 01                 ANI     1
   21b7   ca bb 21              JZ      MUL_NO_ADD
                        
   21ba   19                    DAD     D
                        
   21bb                 MUL_NO_ADD:
                        
                        ; ------------------------------------------------------------
                        ; DE <<= 1
                        ;
                        ; Clear carry before shifting E, then propagate E's high
                        ; bit into D.
                        ; ------------------------------------------------------------
                        
   21bb   af                    XRA     A
                        
   21bc   7b                    MOV     A,E
   21bd   17                    RAL
   21be   5f                    MOV     E,A
                        
   21bf   7a                    MOV     A,D
   21c0   17                    RAL
   21c1   57                    MOV     D,A
                        
                        ; ------------------------------------------------------------
                        ; Examine the next multiplier bit.
                        ;
                        ; RRC is intentional: over eight iterations, each original
                        ; bit of C reaches bit 0 exactly once.
                        ; ------------------------------------------------------------
                        
   21c2   79                    MOV     A,C
   21c3   0f                    RRC
   21c4   4f                    MOV     C,A
                        
   21c5   05                    DCR     B
   21c6   c2 b4 21              JNZ     MUL_LOOP
                        
   21c9   c9                    RET
                        
                        
                        ; ============================================================
                        ; SHR7
                        ;
                        ; Logical right shift HL by 7.
                        ;
                        ; Used only on positive squares.
                        ; ============================================================
                        
   21ca                 SHR7:
                        
   21ca   06 07                 MVI     B,7
                        
   21cc                 SHR7_LOOP:
                        
   21cc   af                    XRA     A
                        
Mandelbrot generator (C) ChatGPT

   21cd   7c                    MOV     A,H
   21ce   1f                    RAR
   21cf   67                    MOV     H,A
                        
   21d0   7d                    MOV     A,L
   21d1   1f                    RAR
   21d2   6f                    MOV     L,A
                        
   21d3   05                    DCR     B
   21d4   c2 cc 21              JNZ     SHR7_LOOP
                        
   21d7   c9                    RET
                        
                        ; ============================================================
                        ; ASR6
                        ;
                        ; Arithmetic right shift signed HL by 6.
                        ; ============================================================
                        
   21d8                 ASR6:
   21d8   cd eb 21              CALL    ASR1
   21db   cd eb 21              CALL    ASR1
   21de   cd eb 21              CALL    ASR1
   21e1   cd eb 21              CALL    ASR1
   21e4   cd eb 21              CALL    ASR1
   21e7   cd eb 21              CALL    ASR1
                        
   21ea   c9                    RET
                        
                        ; ============================================================
                        ; ASR1
                        ;
                        ; Arithmetic right shift signed HL by one.
                        ; ============================================================
                        
   21eb                 ASR1:
                        
   21eb   7c                    MOV     A,H
   21ec   e6 80                 ANI     080H
   21ee   ca f5 21              JZ      ASR_POS
   21f1   37                    STC
   21f2   c3 f6 21              JMP     ASR_DO
                        
   21f5                 ASR_POS:
                        
   21f5   af                    XRA     A
                        
   21f6                 ASR_DO:
                        
   21f6   7c                    MOV     A,H
   21f7   1f                    RAR
   21f8   67                    MOV     H,A
   21f9   7d                    MOV     A,L
   21fa   1f                    RAR
   21fb   6f                    MOV     L,A
                        
   21fc   c9                    RET
                        
Mandelbrot generator (C) ChatGPT

                        ; ============================================================
                        ; ASCII density LUT
                        ;
                        ; 8 entries, from empty to dense.
                        ; ============================================================
                        
   21fd                 DENSITY:
                        
   21fd   20 2e 2d 3d           DB      ' .-=+*#@'
   2201   2b 2a 23 40   
                        
                        ; ============================================================
                        ; TEST ROUTINES
                        ;
                        ; These can be started using the monitor's G command.
                        ;
                        ; Results are stored at 3100H onwards.
                        ; The parameter and working storage at 3000H-3022H are
                        ; otherwise unchanged by the test wrappers, except that
                        ; the point tests deliberately set CUR_X, CUR_Y and ITER_MAX.
                        ; ============================================================
   1210                         ORG     01210H
                        ; ------------------------------------------------------------
                        ; TEST_MUL8_SMALL
                        ;
                        ; 13 * 17 = 221 = 00DDH
                        ;
                        ; Result: 3100H-3101H = DD 00
                        ; THIS TEST HANGS ON MY MACHINE. But it does write the correct result to memory.
                        ; and all the other tests work! And yes I checked, 120A is C9 which is RET.
                        ; ------------------------------------------------------------
                        
   1210                 TEST_MUL8_SMALL:
                        
   1210   06 0d                 MVI     B,13
   1212   0e 11                 MVI     C,17
                        
   1214   cd ac 21              CALL    MUL8
                        
   1217   22 00 31              SHLD    03100H
   121a   c9                    RET
                        
                        ; ------------------------------------------------------------
                        ; TEST_MUL8_LARGE
                        ;
                        ; 255 * 255 = 65025 = FE01H
                        ;
                        ; Result: 3102H-3103H = 01 FE
                        ; ------------------------------------------------------------
                        
   121b                 TEST_MUL8_LARGE:
                        
   121b   06 ff                 MVI     B,255
   121d   0e ff                 MVI     C,255
                        
   121f   cd ac 21              CALL    MUL8
                        
   1222   22 02 31              SHLD    03102H
Mandelbrot generator (C) ChatGPT

   1225   c9                    RET
                        
                        ; ------------------------------------------------------------
                        ; TEST_SMUL_NEGPOS
                        ;
                        ; -3 * 5 = -15 = FFF1H
                        ;
                        ; Result: 3104H-3105H = F1 FF
                        ; ------------------------------------------------------------
                        
   1226                 TEST_SMUL_NEGPOS:
                        
   1226   21 fd ff              LXI     H,0FFFDH
   1229   11 05 00              LXI     D,00005H
                        
   122c   cd 52 21              CALL    SMUL
                        
   122f   22 04 31              SHLD    03104H
   1232   c9                    RET
                        
                        ; ------------------------------------------------------------
                        ; TEST_SMUL_NEGNEG
                        ;
                        ; -3 * -5 = 15 = 000FH
                        ;
                        ; Result: 3106H-3107H = 0F 00
                        ; ------------------------------------------------------------
                        
   1233                 TEST_SMUL_NEGNEG:
                        
   1233   21 fd ff              LXI     H,0FFFDH
   1236   11 fb ff              LXI     D,0FFFBH
                        
   1239   cd 52 21              CALL    SMUL
                        
   123c   22 06 31              SHLD    03106H
   123f   c9                    RET
                        
                        ; ------------------------------------------------------------
                        ; TEST_SHR7
                        ;
                        ; 8000H >> 7 = 0100H
                        ;
                        ; Result: 3108H-3109H = 00 01
                        ; ------------------------------------------------------------
                        
   1240                 TEST_SHR7:
                        
   1240   21 00 80              LXI     H,08000H
                        
   1243   cd ca 21              CALL    SHR7
                        
   1246   22 08 31              SHLD    03108H
   1249   c9                    RET
                        
                        ; ------------------------------------------------------------
                        ; TEST_ASR6
                        ;
Mandelbrot generator (C) ChatGPT

                        ; -128 >> 6 = -2 = FFFEH
                        ;
                        ; Result: 310AH-310BH = FE FF
                        ; ------------------------------------------------------------
                        
   124a                 TEST_ASR6:
                        
   124a   21 80 ff              LXI     H,0FF80H
                        
   124d   cd d8 21              CALL    ASR6
                        
   1250   22 0a 31              SHLD    0310AH
   1253   c9                    RET
                        
                        ; ------------------------------------------------------------
                        ; TEST_POINT_ZERO
                        ;
                        ; c = 0 + 0i
                        ; Expected: 16 iterations
                        ;
                        ; Result: 310CH = 10
                        ; ------------------------------------------------------------
                        
   1254                 TEST_POINT_ZERO:
                        
   1254   21 00 00              LXI     H,0
   1257   22 0b 30              SHLD    CUR_X
   125a   22 0d 30              SHLD    CUR_Y
                        
   125d   3e 10                 MVI     A,16
   125f   32 08 30              STA     ITER_MAX
                        
