0000                     CPU 8085
                        ;	TITLE "Self modifying LED program for MCS-85"

2000                    	ORG 2000H 	; RAM starts HERE
2000  21 0040           START   LXI H, 4000h 	; load HL pair with RAM end location
2003  F9                	SPHL		; init Stack Pointer	

2004  AF                INIT	XRA A		; clear ACCumulator
2005  37                	STC		; set CARRY bit

2006  17                AGAIN	RAL		; rotate RAL or RAR



2007  F5                	PUSH PSW	; store the ACC content in stack
2008  CD 1F20           	CALL DELAY	; call time delay
                        ;	CALL DELAY	; call more time delay
200B  F1                	POP PSW		; restore the ACC content back
200C  D3 61             	OUT 61H		; send it to output port 61H
200E  DC 1420           	CC XOR8
2011  C3 0620           	JMP AGAIN	; do the shift again
2014  3A 0620           XOR8	LDA AGAIN	; load the current rotate instruction	
2017  EE 08             	XRI 08H		; this will change the direction
2019  32 0620           	STA AGAIN	; store the modified instruction	
201C  AF                	XRA A		; clear the ACC
201D  37                	STC		; set CARRY flag
201E  C9                	RET		; return


                        ; --- 16-bit Delay Routine ---
                        ; Input: HL pair holds the 16-bit count (up to FFFFH)
201F                    DELAY:
201F  21 FF7F               	LXI H, 0FFFFH/2   ; [10 T-states] Load HL with 65,535
2022                    LOOP_16:
2022  2B                    	DCX H           ; [6 T-states] Decrement HL pair
2023  7D                    	MOV A, L        ; [4 T-states] Move Low byte to A
2024  B4                    	ORA H           ; [4 T-states] OR with High byte (Sets Zero flag)
2025  C2 2220               	JNZ LOOP_16     ; [10/7 T-states] Jump if result not zero
2028  C9                    	RET             ; [10 T-states]
2029                    	END 		; Added for A85

00000 Total Error(s)

AGAIN              00002006    DELAY              0000201F    INIT               00002004
LOOP_16            00002022    START              00002000    XOR8               00002014
